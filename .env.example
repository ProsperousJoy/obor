# OpenAI API Key (required for AI predictions)
OPENAI_API_KEY=sk-your-key-here

# Polling interval in seconds (default: 60)
POLL_INTERVAL=60

# Server settings
HOST=0.0.0.0
PORT=8000

# Jev AI Decision Supervisor API Key (TypeSafe)
JEV_API_KEY=your-jev-api-key-here

# Demo mode: use simulated data when real API is unavailable
DEMO_MODE=false

# Demo incident seed data URL (accepts https:// or file://)
DEMO_INCIDENTS_URL=https://raw.githubusercontent.com/ProsperousJoy/obor/main/data/demo_incidents.json
